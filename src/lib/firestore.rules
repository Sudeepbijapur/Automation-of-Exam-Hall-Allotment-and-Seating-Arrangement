rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public student search can read a specific seat allocation.
    match /seat_allocations/{usn} {
      allow get: if true;
      // Authenticated users can write and list allocations.
      allow list, write: if request.auth != null;
    }
    
    // Public read for secret code, write for authenticated users.
     match /secrets/{docId} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }

    // Authenticated users have full access to all other collections.
    match /classes/{docId} {
      allow read, write: if request.auth != null;
    }
    match /batches/{docId} {
      allow read, write: if request.auth != null;
    }
    match /electives/{docId} {
      allow read, write: if request.auth != null;
    }
    match /exams/{docId} {
      allow read, write: if request.auth != null;
    }
    match /invigilators/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
