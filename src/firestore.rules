rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow student search to work for anyone
    match /seat_allocations/{usn} {
      allow read: if true;
    }

    // Allow any logged-in user to write to any collection,
    // and read from any collection.
    match /{collection}/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
