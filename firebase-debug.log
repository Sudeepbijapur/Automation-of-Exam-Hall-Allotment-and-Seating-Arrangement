[debug] [2025-08-14T19:28:32.088Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if a user is authenticated\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    // --- Public Access Rules ---\n    // Allow anyone to search for a single seat allocation by USN\n    match /seat_allocations/{docId} {\n      allow get: if true;                  // Public read by USN\n      allow list, write: if isAuthenticated; // Only admins can list or write\n    }\n\n    // Allow public read of secrets (e.g., for admin login)\n    match /secrets/{docId} {\n      allow get: if true;\n      allow write: if isAuthenticated;\n    }\n\n    // --- Authenticated (Admin) Access Rules ---\n    match /classes/{docId} {\n      allow read, write: if isAuthenticated;\n    }\n    match /batches/{docId} {\n      allow read, write: if isAuthenticated;\n    }\n    match /electives/{docId} {\n      allow read, write: if isAuthenticated;\n    }\n    match /exams/{docId} {\n      allow read, write: if isAuthenticated;\n    }\n    match /invigilators/{docId} {\n      allow read, write: if isAuthenticated;\n    }\n\n    // --- Catch-All Rule for Any Future Collections ---\n    // Ensures only authenticated users can access anything not explicitly listed above\n    match /{document=**} {\n      allow read, write: if isAuthenticated;\n    }\n  }\n}\n"}]}}
