[debug] [2025-08-14T17:33:51.151Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Default deny all reads and writes\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // Allow public read for seat allocations for student search\n    match /seat_allocations/{usn} {\n      allow get: if true;\n    }\n    \n    // Allow public read for secrets for admin login check\n    match /secrets/{docId} {\n        allow get: if true;\n    }\n\n    // Allow authenticated users (admins) to perform all actions on all collections\n    match /{path=**} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
