[debug] [2025-08-14T08:21:11.230Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Public read for secrets (for secret code check)\n    match /secrets/{docId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // Public read for seat allocations\n    match /seat_allocations/{usn} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // All other collections require authentication for reads and writes.\n    // This rule is implicitly covered by the more specific rules below\n    // for admin functionality, but is good practice to have a general authenticated rule.\n    match /{collection}/{docId} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
