[debug] [2025-08-11T16:25:41.782Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Default deny: everything requires authentication unless specified otherwise.\n    match /{document=**} {\n      allow read, write: if request.auth != null;\n    }\n\n    // --- Public Read Overrides for Student Search ---\n\n    // Allow anyone to read a specific seat allocation.\n    match /seat_allocations/{usn} {\n      allow get: if true;\n      allow list: if false; // Block listing all seats\n    }\n\n    // Allow anyone to read a specific exam document (for time checking).\n    match /exams/{examId} {\n      allow get: if true;\n      allow list: if false; // Block listing all exams\n    }\n\n    // Allow anyone to query the classes collection by name (for location info).\n    // Note: The frontend uses a 'where' query which requires 'list' permission.\n    match /classes/{classId} {\n      allow get: if true;\n      allow list: if true; // Allows the 'where(\"name\", \"==\", ...)' query\n    }\n    \n    // Allow anyone to read the admin login secret.\n    match /secrets/adminLogin {\n        allow get: if true;\n        allow list: if false;\n    }\n  }\n}\n"}]}}
