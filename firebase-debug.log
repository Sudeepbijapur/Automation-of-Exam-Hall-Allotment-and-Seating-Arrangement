[debug] [2025-08-14T17:41:29.547Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n  \n    // This is a catch-all rule for EVERY collection.\n    // It allows public read access, which is needed for the student search page to work.\n    // It restricts all write operations (create, update, delete) to only authenticated users (admins).\n    // This is the simplest, most effective way to secure an admin-managed app\n    // while allowing public data to be viewed.\n    match /{path=**} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n  }\n}\n"}]}}
