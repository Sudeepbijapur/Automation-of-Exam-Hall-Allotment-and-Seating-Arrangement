[debug] [2025-08-14T18:36:17.307Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check for authenticated users (admin)\n    function isAdmin() {\n      return request.auth != null;\n    }\n\n    // Public student search is allowed to read single documents\n    match /seat_allocations/{usn} {\n      allow get: if true;\n      allow list, write: if isAdmin();\n    }\n    \n    // Public read for secret admin code, write for admin\n     match /secrets/{docId} {\n      allow get: if true;\n      allow list, write: if isAdmin();\n    }\n\n    // Explicit rules for all admin-managed collections\n    match /classes/{docId} {\n      allow read, write: if isAdmin();\n    }\n    match /batches/{docId} {\n      allow read, write: if isAdmin();\n    }\n    match /electives/{docId} {\n      allow read, write: if isAdmin();\n    }\n    match /exams/{docId} {\n      allow read, write: if isAdmin();\n    }\n    match /invigilators/{docId} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n"}]}}
