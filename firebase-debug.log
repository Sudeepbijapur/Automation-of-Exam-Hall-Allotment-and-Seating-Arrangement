[debug] [2025-08-14T19:30:44.393Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if a user is authenticated (admin)\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    // --- Public Access ---\n    // Students can search their seat allocation by USN without login\n    match /seat_allocations/{usn} {\n      allow get: if true;           // Anyone can fetch a single doc\n      allow list, create, update, delete: if isAuthenticated(); // Only admin\n    }\n\n    // Secret documents (like admin codes) can be read by anyone for checks\n    match /secrets/{docId} {\n      allow get: if true;\n      allow list, create, update, delete: if isAuthenticated();\n    }\n\n    // --- Admin Access (Authenticated users) ---\n    // Admin can read, list, write, update, delete all data\n    match /classes/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /batches/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /electives/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /exams/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /invigilators/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n  }\n}\n"}]}}
