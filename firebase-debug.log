[debug] [2025-08-14T19:16:36.620Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // -------------------------------\n    // Seat allocations\n    // -------------------------------\n    // Public read: students can search by USN\n    // Admin write: only authenticated users can create/update/delete\n    match /seat_allocations/{usn} {\n      allow get: if true;                       // anyone can fetch by USN\n      allow list: if false;                     // prevent listing all\n      allow create, update, delete: if request.auth != null; // admin only\n    }\n\n    // -------------------------------\n    // Exams\n    // -------------------------------\n    // Authenticated users can read, update, and delete exams\n    match /exams/{examId} {\n      allow read, update, delete: if request.auth != null;\n      allow create: if request.auth != null;    // allow creating new exams\n    }\n\n    // -------------------------------\n    // Classes, Batches, Electives, Invigilators, Secrets\n    // -------------------------------\n    // Only authenticated users (admin) can read/write\n    match /{collection}/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // -------------------------------\n    // Nested collections under any doc\n    // -------------------------------\n    // Ensures future nested documents also require authentication\n    match /{path=**}/{document} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
