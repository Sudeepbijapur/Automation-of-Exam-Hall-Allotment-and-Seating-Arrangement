[debug] [2025-08-14T08:24:15.174Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Allow public read for collections needed by the student search page.\n    // This allows unauthenticated users to find their seat or check a secret code.\n    match /secrets/{docId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    match /seat_allocations/{usn} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    match /exams/{examId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    match /classes/{classId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // All other collections used by the admin panel require authentication\n    // for both read and write operations.\n    match /batches/{batchId} {\n      allow read, write: if request.auth != null;\n    }\n    \n    match /electives/{electiveId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /invigilators/{invigilatorId} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
