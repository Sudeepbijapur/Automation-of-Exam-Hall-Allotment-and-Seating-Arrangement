[debug] [2025-08-11T16:01:03.731Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Allow public GET access for collections needed by the student search page.\n    // This allows fetching a single document by its ID, but prevents listing all documents.\n    // Writes are still restricted to authenticated users.\n\n    // For checking admin login code\n    match /secrets/{secretId} {\n      allow get: if true;\n      allow write: if request.auth != null;\n    }\n    \n    // For fetching seat allocation by USN\n    match /seat_allocations/{usn} {\n      allow get: if true;\n      allow write: if request.auth != null;\n    }\n\n    // For fetching exam details (date, time) linked to an allocation\n    match /exams/{examId} {\n      allow get: if true;\n      allow write: if request.auth != null;\n    }\n\n    // For fetching class details (location) linked to an allocation\n    match /classes/{classId} {\n      allow get: if true;\n      allow write: if request.auth != null;\n    }\n\n    // Default deny for all other collections for unauthenticated users.\n    // Authenticated users (admins) have full access to other collections like batches, electives, etc.\n    match /{path=**} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}"}]}}
