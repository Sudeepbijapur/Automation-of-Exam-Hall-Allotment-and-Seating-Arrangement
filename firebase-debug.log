[debug] [2025-08-14T17:42:36.157Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // This rule allows anyone to read seat allocation documents, which is\n    // needed for the public student search page.\n    // Crucially, it only allows authenticated users (your admin account) to create,\n    // update, or delete seat allocations, which is what happens when you publish an exam.\n    match /seat_allocations/{usn} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n    \n    // This is a wildcard rule that applies to all other collections (exams, classes, etc.).\n    // It requires a user to be logged in (request.auth != null) for any action.\n    // This secures your admin data while giving you full control when logged in.\n    match /{collection}/{docId} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
