[debug] [2025-08-14T18:33:54.954Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // -----------------------------\n    // Seat Allocations\n    // -----------------------------\n    // Students can read seat allocations without login\n    match /seat_allocations/{usn} {\n      allow get: if true;              // public read of a single document\n      allow list, create, update, delete: if request.auth != null; // only admin\n    }\n\n    // -----------------------------\n    // Secrets (optional admin codes)\n    // -----------------------------\n    match /secrets/{docId} {\n      allow get: if true;              // public read if needed\n      allow list, create, update, delete: if request.auth != null; // only admin\n    }\n\n    // -----------------------------\n    // All other collections\n    // -----------------------------\n    // Admins can read/write exams, classes, batches, electives, invigilators\n    match /{path=**}/{document} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
