[debug] [2025-08-14T17:37:53.767Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // This rule allows anyone to read from seat_allocations and secrets,\n    // which is necessary for the public student search page and the admin login code.\n    // However, only authenticated users (admins) are allowed to write (create, update, delete).\n    match /seat_allocations/{docId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n     match /secrets/{docId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // This is a catch-all rule for EVERY OTHER collection (like exams, classes, etc.).\n    // It requires a user to be logged in for any and all actions.\n    match /{document=**} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
