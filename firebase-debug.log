[debug] [2025-08-14T19:12:30.021Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if a user is logged in\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    // --- Public Facing Rules ---\n\n    // Students can search for their seat allocation by USN\n    match /seat_allocations/{usn} {\n      allow get: if true; // Public can read one document\n      // Authenticated user can list all and write\n      allow list, write: if isAuthenticated();\n    }\n    \n    // The secret admin code can be read publicly if needed\n    match /secrets/{docId} {\n      allow get: if true;\n      allow list, write: if isAuthenticated();\n    }\n\n    // --- Authenticated User (Admin) Rules ---\n\n    // Full read/write access for the authenticated user on exams\n    match /exams/{examId} {\n      allow read, update, delete, create: if isAuthenticated();\n    }\n\n    // Full access for all other admin collections\n    match /classes/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /batches/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /electives/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n    match /invigilators/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n  }\n}\n"}]}}
