[debug] [2025-08-14T17:47:33.555Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // 1. Seat allocations: public read, only admins can write.\n    // This allows students to search for their seat.\n    match /seat_allocations/{usn} {\n      allow read: if true;\n      allow create, update, delete: if request.auth != null;\n    }\n\n    // 2. Secrets: Public read for admin code lookup, admin-only write.\n    match /secrets/{docId} {\n        allow read: if true;\n        allow write: if request.auth != null;\n    }\n\n    // 3. All other collections are admin-only.\n    // This secures all your management data (exams, classes, batches, etc.).\n    match /batches/{docId} { allow read, write: if request.auth != null; }\n    match /classes/{docId} { allow read, write: if request.auth != null; }\n    match /electives/{docId} { allow read, write: if request.auth != null; }\n    match /exams/{docId} { allow read, write: if request.auth != null; }\n    match /invigilators/{docId} { allow read, write: if request.auth != null; }\n  }\n}\n"}]}}
