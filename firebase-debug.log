[debug] [2025-08-14T17:37:08.294Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Public read for seat_allocations, write only for logged-in users.\n    // This allows the student search to work for everyone.\n    match /seat_allocations/{usn} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // All other collections (classes, batches, exams, etc.) require the user\n    // to be logged in for both read and write operations.\n    // This rule does NOT apply to seat_allocations because a more specific\n    // rule already matched it above.\n    match /{path=**}/batches/{batchId} {\n      allow read, write: if request.auth != null;\n    }\n    match /{path=**}/classes/{classId} {\n        allow read, write: if request.auth != null;\n    }\n    match /{path=**}/electives/{electiveId} {\n        allow read, write: if request.auth != null;\n    }\n    match /{path=**}/invigilators/{invigilatorId} {\n        allow read, write: if request.auth != null;\n    }\n    match /{path=**}/exams/{examId} {\n        allow read, write: if request.auth != null;\n    }\n     match /{path=**}/secrets/{secretId} {\n        allow read, write: if request.auth != null;\n    }\n  }\n}"}]}}
