[debug] [2025-08-14T17:35:10.551Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // --- PUBLIC READ-ONLY ACCESS ---\n    // Allow anyone to read seat allocations and secrets for the student search page.\n    // Only authenticated users (admins) can write to these collections.\n    match /seat_allocations/{usn} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n    match /secrets/{docId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // --- ADMIN-ONLY COLLECTIONS ---\n    // Require user to be authenticated (logged in) to perform any operation\n    // on these specific collections.\n    match /batches/{docId} {\n      allow read, write: if request.auth != null;\n    }\n    match /classes/{docId} {\n      allow read, write: if request.auth != null;\n    }\n    match /electives/{docId} {\n      allow read, write: if request.auth != null;\n    }\n    match /invigilators/{docId} {\n      allow read, write: if request.auth != null;\n    }\n    match /exams/{docId} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n"}]}}
